<%@ page pageEncoding="UTF-8" %>
<%--
    Fragmento COMÚN: filtro por fecha de registro (desde / hasta) de los listados.
    Necesita la variable rangoFechas (RangoFechasDTO) declarada en la página.
    Si el usuario no eligió fechas, los campos quedan vacíos: así, al buscar un
    DNI o un nombre, se busca en todo el historial y no solo en los últimos 30 días.
--%>
<div class="col-6 col-md-3 col-lg-2 mb-2">
    <label for="desde" class="small text-muted mb-1">Registrado desde</label>
    <input type="date" id="desde" name="desde" class="form-control" max="<%= java.time.LocalDate.now() %>"
           value="<%= rangoFechas.isElegido() ? rangoFechas.desdeIso() : "" %>">
</div>
<div class="col-6 col-md-3 col-lg-2 mb-2">
    <label for="hasta" class="small text-muted mb-1">Hasta</label>
    <input type="date" id="hasta" name="hasta" class="form-control" max="<%= java.time.LocalDate.now() %>"
           value="<%= rangoFechas.isElegido() ? rangoFechas.hastaIso() : "" %>">
</div>
