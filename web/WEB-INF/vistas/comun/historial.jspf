<%@ page pageEncoding="UTF-8" %>
<%--
    Fragmento COMÚN: "Últimos cambios" de un registro, leído de la auditoría (RNF-10 trazabilidad).
    Usa el atributo "historial" (List<AuditoriaDTO>) que pone el controlador.
--%>
<%
    @SuppressWarnings("unchecked")
    java.util.List<modelo.dto.AuditoriaDTO> historial = (java.util.List<modelo.dto.AuditoriaDTO>) request.getAttribute("historial");
%>
<% if (historial != null) { %>
<div class="card">
    <div class="card-header"><h3 class="card-title"><i class="fas fa-history mr-2"></i>Últimos cambios</h3></div>
    <div class="card-body p-0">
    <% if (historial.isEmpty()) { %>
        <p class="small text-muted p-3 mb-0">Sin movimientos registrados todavía.</p>
    <% } else { %>
        <ul class="list-group list-group-flush small historial">
        <% for (modelo.dto.AuditoriaDTO h : historial) { %>
            <li class="list-group-item">
                <div class="d-flex justify-content-between"><strong><%= EscapeHtml.texto(h.getDescripcion()) %></strong>
                    <span class="text-muted text-nowrap ml-2"><%= controlador.FormatoVista.fechaHora(h.getFecha()) %></span></div>
                <div class="text-muted">por @<%= EscapeHtml.texto(h.getUsuario()) %></div>
                <% if (!h.getDetalle().isEmpty()) { %><div class="text-break"><%= EscapeHtml.texto(h.getDetalle()) %></div><% } %>
            </li>
        <% } %>
        </ul>
    <% } %>
    </div>
</div>
<% } %>
